{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "elm369://schema/liquid3d/prompt/1.0.0",
  "title": "ELM369 Liquid-3D Prompt Packet",
  "type": "object",
  "required": ["prompt_id", "project_id", "mode", "subject", "rendered", "created_at"],
  "properties": {
    "prompt_id": {"type": "string"},
