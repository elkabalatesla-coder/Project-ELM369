{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "CreatorIdentificationCard",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "description": "Unique identifier for the creator."
    },
    "name": {
      "type": "string",
      "description": "Name of the creator."
    },
    "email": {
      "type": "string",
      "format": "email",
      "description": "Email address of the creator."
    },
    "profilePicture": {
      "type": "string",
      "format": "uri",
      "description": "URL of the creator's profile picture."
    },
    "socialLinks": {
      "type": "array",
      "items": {
        "type": "string",
        "format": "uri"
      },
      "description": "Array of social media links."
    },
    "bio": {
      "type": "string",
      "description": "Short biography of the creator."
    },
    "createdDate": {
      "type": "string",
      "format": "date-time",
      "description": "Timestamp when the creator was registered."
    }
  },
  "required": ["id", "name", "email", "createdDate"]
}
